<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Fullscreen Timer</title>
  <style>
    /* Root CSS variables for colors */
    :root {
      --bg: black;
      --fg: white;
      --accent: #ff4444;
      --warning: red;
      --stroke: black;
      --outline-w: 0.6vw; /* UI outline thickness (vw) */
      --outline-text: 0.04em; /* Text stroke thickness (scales with font) */
      --chroma: #00FF00; /* default chroma key color */
      --action-w: 20ch; /* unified width for bottom controls */
      --action-h: calc(1.8em + 18px); /* unified height matches toggle */
    }

    /* Light mode color overrides */
    body.light {
      --bg: white;
      --fg: black;
      --accent: red;
      --warning: red;
    }

    /* Chroma key mode overrides and text stroke */
    body.chroma {
      /* Background becomes chroma variable */
      --bg: var(--chroma);
      /* Keep text white unless warning overrides it */
      --fg: white;
    }

    /* Chroma outlines only on the timer text (outside-only via layered stroke) */
    body.chroma #timer {
      position: relative;
      z-index: 0; /* create stacking context for behind-layer */
    }
    body.chroma #timer::before {
      content: attr(data-text);
      position: absolute;
      inset: 0;
      color: transparent;
      -webkit-text-fill-color: transparent;
      -webkit-text-stroke: var(--outline-text) var(--stroke);
      /* Larger shadow layered behind stroke + fill */
      text-shadow: 0.45vw 0.45vw 1vw rgba(0, 0, 0, 0.9);
      pointer-events: none;
      z-index: -1; /* ensure shadow+stroke sit behind white fill */
    }

    

    /* Outline around progress bar container (and bar) in chroma mode */
    body.chroma #progressContainer,
    body.chroma #progressBar {
      box-shadow: 0 0 0 var(--outline-w) var(--stroke);
    }

    /* Fullscreen body and html setup */
    html, body {
      margin: 0; padding: 0;
      height: 100%; width: 100%;
      background: var(--bg);
      color: var(--fg);
      font-family: sans-serif;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      user-select: none; /* Disable text selection */
      overflow: hidden;
    }

    /* Hide mouse cursor when active */
    body.hide-cursor {
      cursor: none;
    }

    /* Controls container at top center */
    #controls {
      position: absolute;
      top: 40px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 10px;
      font-size: 1.5vw;
      z-index: 10;
      flex-wrap: wrap;
      justify-content: center;
      user-select: none;
    }

    /* Preset time buttons container styling */
    #presetTimes {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      margin-top: 8px;
      user-select: none;
    }
    /*Preset Label Styling*/
    #presetLabel {
  font-size: 1.3vw;
  margin-bottom: 4px;
  color: var(--fg);
  font-weight: bold;
  user-select: none;
    }

    /* Preset time buttons style */
    #presetTimes button {
      padding: 4px 10px;
      font-size: 1em;
      cursor: pointer;
      user-select: none;
    }

    /* Timer queue container */
    #queueContainer {
      position: absolute;
      top: 50%;
      right: 20px;
      transform: translateY(-50%);
      width: 280px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 10;
      user-select: none;
    }

    #queueContainer h3 {
      margin: 0;
      font-size: 1.1em;
    }

    #queueForm {
      display: flex;
      gap: 8px;
    }

    #queueForm input[type="text"] {
      flex: 1;
      min-width: 0;
    }

    #queueList {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
      max-height: 40vh;
      overflow-y: auto;
    }

    .queueItem {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      border: 1px solid var(--fg);
      border-radius: 4px;
      padding: 4px 8px;
    }

    .queueItem span {
      flex: 1;
    }

    .queueRemoveBtn {
      font-size: 0.9em;
      padding: 4px 8px;
      min-width: auto;
    }

    .queueEmpty {
      border: 1px dashed var(--fg);
      border-radius: 4px;
      padding: 6px 8px;
      text-align: center;
      font-size: 0.95em;
      opacity: 0.7;
    }

    #startQueueBtn {
      width: 100%;
    }

    #queueActions {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 8px;
    }

    #queueActions > button {
      width: 100%;
    }

    #queueSecondary {
      display: flex;
      gap: 12px;
      align-items: center;
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    #queueSecondary button {
      width: auto;
      padding: 6px 16px;
    }

    #autoNextGroup {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.9em;
      white-space: nowrap;
    }

    #autoNextGroup input {
      width: 1.1em;
      height: 1.1em;
    }
    #nextTimerButton {
      position: fixed;
      bottom: 8px;
      right: 8px;
      z-index: 60;
      min-width: calc(var(--action-w) * 1.5);
      height: calc(var(--action-h) * 1.5);
      font-size: 1.2em;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px 28px;
    }
    /* Start button container fixed at bottom center */
    #startContainer {
      position: absolute;
      bottom: 40px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      display: flex;
      flex-direction: column; /* Start button on first row, toggles below */
      align-items: center;
      gap: 12px;
      user-select: none;
    }

    /* Start button style */
    #startBtn {
      font-size: 1.2em; /* match toggle text */
      padding: 0 15px; /* match toggle horizontal */
      height: var(--action-h); /* match toggle height */
      min-width: var(--action-w);
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      border-radius: 2px; /* match toggle shape */
      user-select: none;
    }

    /* Row of toggles under Start */
    #startToggles {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
    }

    /* Timer display big text centered */
    #timer {
      text-align: center;
      font-size: 15vw; /* responsive large font size */
      user-select: none;
    }

    /* Subtle drop shadow for readability when not in chroma */
    body:not(.chroma) #timer {
      text-shadow: 0.2vw 0.2vw 0.3vw rgba(0, 0, 0, 0.45);
    }

    /* Color utility classes */
    .red {
      color: var(--accent);
    }

    .white {
      color: var(--fg);
    }

    .warning {
      color: var(--warning);
    }

    /* Shortcut key legend position */
    #shortcutIndex {
      position: absolute;
      top: 56px; /* shifted below Reset Defaults button */
      left: 20px;
      font-size: clamp(11.55px, 0.99vw, 16.5px); /* 50% smaller */
      font-weight: 700;
      color: var(--fg);
      user-select: none;
      opacity: 1;
      line-height: 1.3;
      max-width: none; /* allow full line without wrapping */
      white-space: nowrap; /* keep each keybind on a single line */
      font-family: monospace;
      z-index: 20;
    }

    /* Reset Defaults button (top-left) */
    #resetDefaultsBtn {
      position: absolute;
      top: 6px;
      left: 6px;
      z-index: 50;
      font-size: 1.425em; /* 50% larger than 0.95em */
      padding: 6px 15px; /* 50% larger */
    }

    /* Hide elements utility */
    .hidden {
      display: none !important;
    }

    /* Progress bar container */
    #progressContainer {
      background: #444;
      border-radius: 5px;
      margin-top: 20px;
      overflow: hidden;
      height: 0.75vw; /* 50% thicker default */
      width: 50vw;
      user-select: none;
    }
    

    /* Actual progress bar fill */
    #progressBar {
      height: 100%;
      width: 0%;
      background: var(--accent);
      transition: width 1s linear;
      user-select: none;
    }

    /* Bottom left color pickers stacked vertically */
    #colorGrid {
      position: absolute;
      bottom: 20px;
      left: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
      justify-content: center;
      z-index: 10;
      user-select: none;
    }

    /* Color picker labels */
    #colorGrid label {
      display: flex;
      align-items: center;
      gap: 8px;
      user-select: none;
    }

    /* Show chroma color control only in chroma mode */
    #chromaColorGroup { display: none; }
    body.chroma #chromaColorGroup { display: flex; }

    /* Bottom right controls stacked vertically */
    #bottomRightControls {
      position: absolute;
      bottom: 20px;
      right: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      align-items: flex-end;
      justify-content: center;
      z-index: 10;
      user-select: none;
    }

    /* Labels and buttons inside bottom right controls */
    #bottomRightControls > label,
    #bottomRightControls > button {
      display: flex;
      align-items: center;
      gap: 8px;
      user-select: none;
    }

    /* Top-right timer size control */
    #topRightControls {
      position: absolute;
      top: 40px;
      right: 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      z-index: 10;
      user-select: none;
    }

    /* Align the timer size label and slider nicely */
    #topRightControls label {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    #topRightControls input[type="range"] {
      vertical-align: middle;
      position: relative;
      top: 1px; /* slight nudge to visually center */
    }


    /* Square toggle button styling for checkboxes */
    .toggleBtn {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 15px; /* 50% larger */
      border: 1px solid var(--fg);
      border-radius: 2px; /* more square */
      background: var(--bg);
      color: var(--fg);
      cursor: pointer;
      min-width: var(--action-w);
      height: var(--action-h);
      box-sizing: border-box;
      justify-content: center;
    }
    .toggleBtn input[type="checkbox"] {
      appearance: none;
      width: 1.8em;  /* 50% larger */
      height: 1.8em; /* 50% larger */
      border: 2px solid var(--fg);
      border-radius: 2px;
      display: inline-block;
      position: relative;
      background: transparent;
      margin: 0;
    }
    .toggleBtn input[type="checkbox"]:checked {
      background: #fff; /* replace red fill with white */
      border-color: var(--fg); /* keep visible border */
    }
    .toggleBtn input[type="checkbox"]:checked::after {
      content: '✓';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -52%);
      font-size: 1.3em; /* scale checkmark with bigger box */
      color: #000; /* default black tick */
    }

    /* Tick color unified to black via default rule above */

    /* Form inputs, buttons, selects and labels styling */
    input, button, select, label {
      font-size: 1.2em;
      padding: 6px 12px;
      background: var(--bg);
      color: var(--fg);
      border: 1px solid var(--fg);
      border-radius: 4px;
      user-select: none;
    }

    /* Warning threshold select width */
    #redThreshold {
      width: auto;
      min-width: 100px;
      white-space: nowrap;
    }

    /* Timer size slider width */
    #timerSizeSlider {
      width: 120px;
    }

    /* Warning label text smaller */
    #warningLabel {
      font-size: 0.9em;
    }

    /* Smaller select inside warning label */
    #warningLabel select {
      font-size: 0.85em;
      padding: 4px 8px;
    }

    /* Paused text displayed bottom center */
    #pausedText {
      position: absolute;
      bottom: 10px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 1.5vw;
      color: var(--accent);
      font-weight: bold;
      user-select: none;
      z-index: 30;
    }
  </style>
</head>
<body class="dark">
  <button id="resetDefaultsBtn" title="Restore default settings">Reset Defaults</button>
  <!-- Controls container with input and preset buttons -->
  <div id="controls">
    <input type="text" id="timeInput" placeholder="mm:ss or seconds" autocomplete="off" />

    <label id="warningLabel" for="redThreshold" style="display: flex; align-items: center; gap: 6px; font-weight: normal; user-select:none;">
      Warning:
      <select id="redThreshold" aria-label="Warning" style="font-weight: normal;">
        <option value="0" selected>None</option>
        <option value="15">15 seconds</option>
        <option value="30">30 seconds</option>
        <option value="60">1 minute</option>
        <option value="120">2 mins</option>
        <option value="300">5 mins</option>
        <option value="600">10 mins</option>
      </select>
    </label>

    <!-- Preset time buttons for quick set -->
    <div style="display: flex; flex-direction: column; align-items: center;">
  <div id="presetLabel">Presets</div>
  <div id="presetTimes">
    <button data-time="60">1:00</button>
    <button data-time="180">3:00</button>
    <button data-time="300">5:00</button>
    <button data-time="600">10:00</button>
  </div>
</div>

  </div>

  <!-- Timer queue manager -->
  <div id="queueContainer" class="hidden">
    <h3>Timer Queue</h3>
    <div id="queueForm">
      <input type="text" id="queueTimeInput" placeholder="mm:ss or seconds" autocomplete="off" />
      <button id="queueAddBtn">Add</button>
    </div>
    <ul id="queueList"></ul>
    <div id="queueActions">
      <button id="startQueueBtn" disabled>Start Queue</button>
      <div id="queueSecondary">
        <button id="clearQueueBtn">Clear Queue</button>
        <label id="autoNextGroup"><input type="checkbox" id="autoNextToggle" /> Auto Next</label>
      </div>
    </div>
  </div>
  <div id="startContainer">
    <button id="startBtn">Start</button>
    <div id="startToggles">
      <label class="toggleBtn" for="showProgress"><input type="checkbox" id="showProgress" /> Progress Bar</label>
      <label class="toggleBtn"><input type="checkbox" id="countUpToggle" /> Count Up</label>
      <label class="toggleBtn"><input type="checkbox" id="autostartToggle" /> Autostart</label>
      <label class="toggleBtn"><input type="checkbox" id="queueToggle" /> Queue</label>
    </div>
  </div>

  <!-- Bottom left color pickers -->
  <div id="colorGrid">
    <label for="bgColor">Background <input type="color" id="bgColor" /></label>
    <label for="fgColor">Text <input type="color" id="fgColor" /></label>
    <label id="progressColorGroup" for="accentColor">Progress <input type="color" id="accentColor" /></label>
    <label for="warningColor">Warning <input type="color" id="warningColor" /></label>
    <label id="chromaColorGroup" for="chromaColor" style="display:none">Chroma <input type="color" id="chromaColor" value="#00FF00" /></label>
  </div>

  <!-- Bottom right controls -->
  <div id="bottomRightControls">
    <button id="modeToggle">Light Mode</button>
    <button id="chromaModeToggle">Chroma Mode</button>
    <button id="minimalModeToggle">Minimal Mode</button>
  </div>

  <button id="nextTimerButton" class="hidden">Next</button>

  <!-- Top right timer size slider -->
  <div id="topRightControls">
    <label for="timerSizeSlider">Timer Size <input type="range" id="timerSizeSlider" min="3" max="40" value="20" /></label>
  </div>

  <!-- Timer display -->
  <div id="timer" class="white">00:00</div>

  <!-- Progress bar container and bar -->
  <div id="progressContainer">
    <div id="progressBar"></div>
  </div>

  

  <!-- Keyboard shortcut legend -->
  <div id="shortcutIndex">
    R – Reset Timer<br />
    Esc – Stop<br />
    Enter – Start<br />
    Space – Pause/Resume<br />
    0–9 – Type Time<br />
    L – Light/Dark Mode<br />
    M – Minimal Mode<br />
    C – Count Up/Down<br />
    P – Toggle Progress Bar<br />
    A – Toggle Autostart<br />
    Q - Toggle Queue
  </div>

  <!-- Paused text overlay -->
  <div id="pausedText" class="hidden">Paused</div>

  <script>
    // Cache references to frequently used DOM elements for performance and clarity
    const timerEl = document.getElementById('timer');
    const timerSizeSlider = document.getElementById('timerSizeSlider');
    const bgColor = document.getElementById('bgColor');
    const fgColor = document.getElementById('fgColor');
    const accentColor = document.getElementById('accentColor');
    const warningColor = document.getElementById('warningColor');
    const chromaColor = document.getElementById('chromaColor');
    const progressColorGroup = document.getElementById('progressColorGroup');
    const chromaColorGroup = document.getElementById('chromaColorGroup');
    const startBtn = document.getElementById('startBtn');
    const progressContainer = document.getElementById('progressContainer');
    const progressBar = document.getElementById('progressBar');
    const timeInput = document.getElementById('timeInput');
    const redThresholdSelect = document.getElementById('redThreshold');
    const showProgressCheckbox = document.getElementById('showProgress');
    const body = document.body;
    const controls = document.getElementById('controls');
    const shortcutIndex = document.getElementById('shortcutIndex');
    const startContainer = document.getElementById('startContainer');
    const minimalModeToggle = document.getElementById('minimalModeToggle');
    const modeToggle = document.getElementById('modeToggle');
    const chromaModeToggle = document.getElementById('chromaModeToggle');
    const colorGrid = document.getElementById('colorGrid');
    const bottomRightControls = document.getElementById('bottomRightControls');
    const topRightControls = document.getElementById('topRightControls');
    const pausedText = document.getElementById('pausedText');
    const autostartToggle = document.getElementById('autostartToggle');
    const resetDefaultsBtn = document.getElementById('resetDefaultsBtn');
    const countUpToggle = document.getElementById('countUpToggle');
    const queueContainer = document.getElementById('queueContainer');
    const queueList = document.getElementById('queueList');
    const queueTimeInput = document.getElementById('queueTimeInput');
    const queueAddBtn = document.getElementById('queueAddBtn');
    const autoNextToggle = document.getElementById('autoNextToggle');
    const clearQueueBtn = document.getElementById('clearQueueBtn');
    const queueToggle = document.getElementById('queueToggle');
    const startQueueBtn = document.getElementById('startQueueBtn');
    const nextTimerButton = document.getElementById('nextTimerButton');

    // Core timer state variables control countdown behaviour, queue progression, and UI state
    let duration = 0;       // Total duration set by user
    let timeRemaining = 0;  // Countdown time left (for countdown mode)
    let elapsed = 0;        // Elapsed seconds (for count-up mode)
    let countUp = false;    // Count-up mode flag
    let running = false;    // Timer is running or not
    let paused = false;     // Timer paused state
    let timerInterval;      // Interval ID for ticking
    let freshInput = true;  // Flag to track fresh input for time typing
    let timerQueue = [];    // Pending timers in queue
    let queueActive = false; // Queue processing flag
    let currentQueueDuration = null; // Original duration of active queue timer
    let queueAwaitingNext = false; // Waiting for manual next trigger
    let autoNextEnabled = false; // Auto-advance flag
    autoNextEnabled = autoNextToggle ? autoNextToggle.checked : false;

    // Sync progress bar visibility and control availability based on modes
    function syncProgressUI() {
      if (countUpToggle && countUpToggle.checked) {
        // Count up disables progress bar completely
        showProgressCheckbox.checked = false;
        showProgressCheckbox.disabled = true;
        progressContainer.style.display = 'none';
        if (typeof progressColorGroup !== 'undefined' && progressColorGroup) {
          progressColorGroup.style.display = 'none';
        }
        return;
      }

      if (minimalModeToggle.classList.contains('active')) {
        // Minimal forces progress bar on and locks it
        showProgressCheckbox.checked = true;
        showProgressCheckbox.disabled = true;
        progressContainer.style.display = 'block';
        if (typeof progressColorGroup !== 'undefined' && progressColorGroup) {
          progressColorGroup.style.display = 'flex';
        }
      } else {
        // Normal behavior
        showProgressCheckbox.disabled = false;
        progressContainer.style.display = showProgressCheckbox.checked ? 'block' : 'none';
        if (typeof progressColorGroup !== 'undefined' && progressColorGroup) {
          progressColorGroup.style.display = showProgressCheckbox.checked ? 'flex' : 'none';
        }
      }
    }

    // Parse input time string ("mm:ss" or seconds) into seconds number
    function parseTimeInput(value) {
      const parts = value.split(':');
      if (parts.length === 2) {
        const minutes = parseInt(parts[0], 10);
        const seconds = parseInt(parts[1], 10);
        if (!isNaN(minutes) && !isNaN(seconds)) {
          return minutes * 60 + seconds;
        }
      }
      const num = parseInt(value, 10);
      return isNaN(num) ? 0 : num;
    }

    // Format seconds number into "mm:ss" string
    function formatTime(seconds) {
      const m = String(Math.floor(seconds / 60)).padStart(2, '0');
      const s = String(seconds % 60).padStart(2, '0');
      return `${m}:${s}`;
    }

    // Render the queue list and enable/disable queue actions based on current data
    function renderQueue() {
      if (!queueList) return;
      queueList.innerHTML = '';
      if (timerQueue.length === 0) {
        const emptyState = document.createElement('li');
        emptyState.className = 'queueEmpty';
        emptyState.textContent = 'No timers queued';
        queueList.appendChild(emptyState);
      } else {
        timerQueue.forEach((seconds, index) => {
          const item = document.createElement('li');
          item.className = 'queueItem';
          const label = document.createElement('span');
          label.textContent = formatTime(seconds);
          item.appendChild(label);
          const removeBtn = document.createElement('button');
          removeBtn.className = 'queueRemoveBtn';
          removeBtn.textContent = 'Remove';
          removeBtn.addEventListener('click', () => {
            timerQueue.splice(index, 1);
            renderQueue();
          });
          item.appendChild(removeBtn);
          queueList.appendChild(item);
        });
      }
      if (startQueueBtn) {
        startQueueBtn.disabled = timerQueue.length === 0 || running;
      }
      if (clearQueueBtn) {
        clearQueueBtn.disabled = timerQueue.length === 0;
      }
      updateQueueVisibility();
    }

    function addTimeToQueueFromInput() {
      if (!queueTimeInput) return;
      const raw = queueTimeInput.value.trim();
      const seconds = parseTimeInput(raw);
      if (seconds <= 0) return;
      timerQueue.push(seconds);
      queueTimeInput.value = '';
      renderQueue();
    }

    // Start the next queued timer and move focus into fullscreen mode
    function beginQueueTimer() {
      if (running || timerQueue.length === 0) return;
      const nextDuration = timerQueue.shift();
      currentQueueDuration = nextDuration;
      queueActive = true;
      renderQueue();
      startTimer(nextDuration, { fromQueue: true });
    }

    // Decide when the queue panel should be visible based on toggle, running state, and pending next prompt
    function updateQueueVisibility() {
      if (!queueContainer) return;
      const enabledByToggle = queueToggle ? queueToggle.checked : true;
      const shouldHide = running || queueActive || queueAwaitingNext || !enabledByToggle;
      queueContainer.classList.toggle('hidden', shouldHide);
    }


    // Enter fullscreen mode using various vendor prefixes
    async function enterFullscreen() {
      const elem = document.documentElement;
      if (elem.requestFullscreen) {
        await elem.requestFullscreen();
      } else if (elem.webkitRequestFullscreen) {
        await elem.webkitRequestFullscreen();
      } else if (elem.msRequestFullscreen) {
        await elem.msRequestFullscreen();
      }
    }

    // Exit fullscreen mode
    async function exitFullscreen() {
      if (document.fullscreenElement) {
        if (document.exitFullscreen) {
          await document.exitFullscreen();
        } else if (document.webkitExitFullscreen) {
          await document.webkitExitFullscreen();
        } else if (document.msExitFullscreen) {
          await document.msExitFullscreen();
        }
      }
    }

    // Update the timer display text, colors, and progress bar width
    function updateDisplay() {
      // Update displayed time
      const displaySeconds = countUp ? elapsed : timeRemaining;
      timerEl.textContent = formatTime(displaySeconds);
      // Keep pseudo-element in sync for chroma outline
      timerEl.setAttribute('data-text', timerEl.textContent);

      // Warning color handling
      const warningThreshold = parseInt(redThresholdSelect.value, 10);
      if (!countUp) {
        if (warningThreshold > 0 && timeRemaining <= warningThreshold) {
          timerEl.classList.add('warning');
          timerEl.classList.remove('white');
        } else {
          timerEl.classList.add('white');
          timerEl.classList.remove('warning');
        }
      } else {
        if (duration > 0 && warningThreshold > 0) {
          const remaining = Math.max(0, duration - elapsed);
          if (remaining <= warningThreshold) {
            timerEl.classList.add('warning');
            timerEl.classList.remove('white');
          } else {
            timerEl.classList.add('white');
            timerEl.classList.remove('warning');
          }
        } else {
          timerEl.classList.add('white');
          timerEl.classList.remove('warning');
        }
      }


      // Update progress bar width as percentage
      if (duration > 0) {
        const rawPercent = countUp ? (elapsed / duration) * 100 : (timeRemaining / duration) * 100;
        const percent = Math.max(0, Math.min(100, rawPercent));
        progressBar.style.width = percent + '%';
      }
    }

    // Tick handler fires once per second to drive countdown updates and queue transitions
    function tick() {
      if (!paused) {
        if (countUp) {
          elapsed++;
          updateDisplay();
        } else if (timeRemaining > 0) {
          timeRemaining--;
          updateDisplay();
          if (timeRemaining === 0) {
            clearInterval(timerInterval);
            running = false;
            paused = false;
            currentQueueDuration = null;
            updateDisplay();
            body.classList.remove('hide-cursor');
            if (queueActive) {
              queueActive = false;
              if (timerQueue.length > 0) {
                if (autoNextEnabled) {
                  if (nextTimerButton) {
                    nextTimerButton.classList.add('hidden');
                  }
                  beginQueueTimer();
                } else {
                  queueAwaitingNext = true;
                  if (nextTimerButton) {
                    nextTimerButton.classList.remove('hidden');
                  }
                }
              } else {
                queueAwaitingNext = false;
                if (queueToggle) {
                  queueToggle.checked = false;
                }
                if (nextTimerButton) {
                  nextTimerButton.classList.add('hidden');
                }
              }
            } else {
              queueAwaitingNext = false;
              if (nextTimerButton) {
                nextTimerButton.classList.add('hidden');
              }
            }
            renderQueue();
            updateQueueVisibility();
            // Timer ended: stay fullscreen until manual exit
          }
        }
      }
    }


    // Start the timer (async because it enters fullscreen)
    async function startTimer(forcedDuration = null, options = {}) {
      if (running) return;

      const fromQueue = !!(options && options.fromQueue);
      let targetDuration;

      if (forcedDuration !== null && !Number.isNaN(forcedDuration)) {
        targetDuration = forcedDuration;
        countUp = false;
        if (countUpToggle && countUpToggle.checked) {
          countUpToggle.checked = false;
          syncProgressUI();
        }
      } else {
        countUp = countUpToggle ? !!countUpToggle.checked : false;
        targetDuration = parseTimeInput(timeInput.value.trim());
      }

      if (!countUp && targetDuration <= 0) return;

      duration = targetDuration;
      timeRemaining = duration;
      elapsed = 0;
      running = true;
      paused = !autostartToggle.checked;
      freshInput = false;
      updateQueueVisibility();

      if (!fromQueue) {
        queueActive = false;
        currentQueueDuration = null;
      }

      if (forcedDuration !== null && !countUp && timeInput) {
        timeInput.value = formatTime(duration);
      }

      // Hide controls and UI elements
      controls.classList.add('hidden');
      startContainer.classList.add('hidden');
      shortcutIndex.classList.add('hidden');
      colorGrid.classList.add('hidden');
      bottomRightControls.classList.add('hidden');
      topRightControls.classList.add('hidden');
      resetDefaultsBtn.classList.add('hidden');
      if (nextTimerButton) {
        nextTimerButton.classList.add('hidden');
      }
      pausedText.classList.toggle('hidden', !paused);
      body.classList.add('hide-cursor');

      updateDisplay();
      await enterFullscreen();

      timerInterval = setInterval(tick, 1000);
      renderQueue();
    }

    // Stop timer, restore fullscreen UI, and tidy any in-progress queue state
    async function stopTimer() {
      const uiHidden = body.classList.contains('hide-cursor') || controls.classList.contains('hidden');
      if (!running && !paused && !queueActive && !uiHidden) return;

      const wasQueueActive = queueActive;
      const pendingDuration = currentQueueDuration;

      clearInterval(timerInterval);
      running = false;
      paused = false;
      timeRemaining = 0;
      elapsed = 0;
      timerEl.textContent = "00:00";
      timerEl.setAttribute('data-text', timerEl.textContent);
      progressBar.style.width = '0%';

      if (wasQueueActive && pendingDuration !== null) {
        timerQueue.unshift(pendingDuration);
      }
      queueActive = false;
      queueAwaitingNext = false;
      if (queueToggle && timerQueue.length === 0) {
        queueToggle.checked = false;
      }
      currentQueueDuration = null;
      updateQueueVisibility();

      // Show all UI elements again
      controls.classList.remove('hidden');
      startContainer.classList.remove('hidden');
      shortcutIndex.classList.remove('hidden');
      colorGrid.classList.remove('hidden');
      bottomRightControls.classList.remove('hidden');
      topRightControls.classList.remove('hidden');
      resetDefaultsBtn.classList.remove('hidden');
      if (nextTimerButton) {
        nextTimerButton.classList.add('hidden');
      }
      pausedText.classList.add('hidden');
      body.classList.remove('hide-cursor');

      renderQueue();
      await exitFullscreen();

      freshInput = true;
      
    }

    // Reset the timer to the original duration and honor Autostart
    function resetTimer() {
      if (!running && !paused) return;

      clearInterval(timerInterval);
      if (countUp) {
        elapsed = 0;
      } else {
        timeRemaining = duration;
      }
      // If Autostart is off, remain paused; if on, resume
      paused = !autostartToggle.checked;
      running = true;
      updateQueueVisibility();

      // Hide UI controls for fullscreen timer
      controls.classList.add('hidden');
      startContainer.classList.add('hidden');
      shortcutIndex.classList.add('hidden');
      colorGrid.classList.add('hidden');
      bottomRightControls.classList.add('hidden');
      topRightControls.classList.add('hidden');
      resetDefaultsBtn.classList.add('hidden');
      if (nextTimerButton) {
        nextTimerButton.classList.add('hidden');
      }
      pausedText.classList.toggle('hidden', !paused);
      body.classList.add('hide-cursor');

      updateDisplay();

      timerInterval = setInterval(tick, 1000);
      
    }

    // Toggle pause/resume timer
    function togglePause() {
      if (running) {
        paused = !paused;
        // Show or hide paused text overlay
        pausedText.classList.toggle('hidden', !paused);
        
      }
    }

    // Event listeners for buttons and keyboard shortcuts
    if (queueAddBtn) {
      queueAddBtn.addEventListener('click', (e) => {
        e.preventDefault();
        addTimeToQueueFromInput();
      });
    }

    if (queueTimeInput) {
      queueTimeInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          addTimeToQueueFromInput();
        }
      });
    }

    if (clearQueueBtn) {
      clearQueueBtn.addEventListener('click', () => {
        timerQueue = [];
        queueAwaitingNext = false;
        renderQueue();
        if (nextTimerButton) {
          nextTimerButton.classList.add('hidden');
        }
        updateQueueVisibility();
      });
    }

    if (autoNextToggle) {
      autoNextEnabled = autoNextToggle.checked;
      autoNextToggle.addEventListener('change', () => {
        autoNextEnabled = autoNextToggle.checked;
      });
    }

    if (startQueueBtn) {
      startQueueBtn.addEventListener('click', (e) => {
        e.preventDefault();
        beginQueueTimer();
      });
    }

    if (nextTimerButton) {
      nextTimerButton.addEventListener('click', () => {
        nextTimerButton.classList.add('hidden');
        beginQueueTimer();
      });
    }

    if (queueToggle) {
      queueToggle.addEventListener('change', () => {
        updateQueueVisibility();
      });
    }


    renderQueue();

    startBtn.addEventListener('click', (event) => {
      event.preventDefault();
      startTimer();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && (running || queueActive || controls.classList.contains('hidden') || body.classList.contains('hide-cursor'))) {
        stopTimer();  // Escape stops timer
      }

      if (e.key === 'Enter' && !running) {
        startTimer(); // Enter starts timer if not running
        e.preventDefault();
      }

      if (e.key === ' ' && running) {
        togglePause(); // Space pauses/resumes timer
        e.preventDefault();
      }

      if (e.key.toLowerCase() === 'r' && (running || paused)) {
        resetTimer(); // R resets timer if running or paused
        e.preventDefault();
      }

      // Toggle Light/Dark mode with 'L'
      if (e.key.toLowerCase() === 'l') {
        modeToggle.click();
        e.preventDefault();
      }

      // Toggle Minimal mode with 'M'
      if (e.key.toLowerCase() === 'm') {
        minimalModeToggle.click();
        e.preventDefault();
      }

      // Toggle Count Up with 'C'
      if (e.key.toLowerCase() === 'c' && countUpToggle) {
        countUpToggle.checked = !countUpToggle.checked;
        countUpToggle.dispatchEvent(new Event('change'));
        e.preventDefault();
      }

      // Toggle Progress Bar with 'P' (ignored if Minimal is active)
      if (e.key.toLowerCase() === 'p') {
        if (!minimalModeToggle.classList.contains('active')) {
          showProgressCheckbox.checked = !showProgressCheckbox.checked;
          // trigger change handler to update visibility
          showProgressCheckbox.dispatchEvent(new Event('change'));
        }
        e.preventDefault();
      }

      // Toggle Autostart with 'A'
      if (e.key.toLowerCase() === 'a') {
        autostartToggle.checked = !autostartToggle.checked;
        e.preventDefault();
      }

      // Toggle Queue with 'Q'
      if (e.key.toLowerCase() === 'q' && queueToggle) {
        queueToggle.checked = !queueToggle.checked;
        updateQueueVisibility();
        e.preventDefault();

      }
      // If not running, number keys 0-9 input time directly into input box
      if (
        !running &&
        /^\d$/.test(e.key) &&
        document.activeElement !== timeInput &&
        document.activeElement !== redThresholdSelect &&
        document.activeElement !== queueTimeInput
      ) {
        e.preventDefault();
        if (freshInput) {
          timeInput.value = e.key; // fresh input replaces text
          freshInput = false;
        } else {
          timeInput.value += e.key; // append numbers
        }
        timeInput.focus();
      }
    });

    // Change timer font size dynamically from slider
    timerSizeSlider.addEventListener('input', () => {
      const vw = timerSizeSlider.value;
      timerEl.style.fontSize = vw + 'vw';

      // Adjust progress bar size proportionally
      const heightVw = (parseFloat(vw) / 30) * 1.5; // 50% thicker
      progressContainer.style.height = `${heightVw}vw`;
      progressContainer.style.width = `${parseFloat(vw) * 3}vw`;
    });

    // Color pickers update CSS variables live
    bgColor.addEventListener('input', () => {
      document.documentElement.style.setProperty('--bg', bgColor.value);
    });

    fgColor.addEventListener('input', () => {
      document.documentElement.style.setProperty('--fg', fgColor.value);
    });

    accentColor.addEventListener('input', () => {
      document.documentElement.style.setProperty('--accent', accentColor.value);
    });

    warningColor.addEventListener('input', () => {
      document.documentElement.style.setProperty('--warning', warningColor.value);
    });

    // Chroma color updates the chroma variable (used only in chroma mode)
    chromaColor.addEventListener('input', () => {
      document.documentElement.style.setProperty('--chroma', chromaColor.value);
    });

    // Initialize font size and progress bar dimensions on load
    const initVw = timerSizeSlider.value;
    timerEl.style.fontSize = initVw + 'vw';
    // Initialize data-text for chroma outline layering
    timerEl.setAttribute('data-text', timerEl.textContent);
    progressContainer.style.height = ((parseFloat(initVw) / 30) * 1.5) + 'vw';
    progressContainer.style.width = (parseFloat(initVw) * 3) + 'vw';

    // Set initial warning color input from CSS variable
    warningColor.value = getComputedStyle(document.documentElement).getPropertyValue('--warning').trim();
    // Initialize chroma color picker from CSS variable
    chromaColor.value = (getComputedStyle(document.documentElement).getPropertyValue('--chroma').trim() || '#00FF00');

    // If fullscreen mode is exited manually, stop the timer
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) {
        if (running || paused || body.classList.contains('hide-cursor') || queueActive || controls.classList.contains('hidden')) {
          stopTimer();
        }
      }
    });
    // Toggle minimal mode (hide/show timer text)
    minimalModeToggle.addEventListener('click', () => {
      timerEl.classList.toggle('hidden');
      minimalModeToggle.classList.toggle('active');
      // Re-evaluate progress bar rules based on current mode(s)
      syncProgressUI();
      
    });

    // Toggle light/dark mode with button text change
    modeToggle.addEventListener('click', () => {
      body.classList.toggle('light');
      if (body.classList.contains('light')) {
        modeToggle.textContent = 'Dark Mode';
        
      } else {
        modeToggle.textContent = 'Light Mode';
        
      }
    });

    // Toggle chroma key mode and update button label
    chromaModeToggle.addEventListener('click', () => {
      body.classList.toggle('chroma');
      if (body.classList.contains('chroma')) {
        chromaModeToggle.textContent = 'Chroma Off';
        // Sync visible picker with current chroma color
        chromaColor.value = (getComputedStyle(document.documentElement).getPropertyValue('--chroma').trim() || '#00FF00');
        chromaColorGroup.style.display = 'flex';
        
      } else {
        chromaModeToggle.textContent = 'Chroma Mode';
        chromaColorGroup.style.display = 'none';
        
      }
    });

    

    // Preset time buttons fill input with formatted time
    document.querySelectorAll('#presetTimes button').forEach(btn => {
      btn.addEventListener('click', () => {
        timeInput.value = formatTime(parseInt(btn.dataset.time));
      });
    });

    // Show/hide progress bar based on checkbox state initially
    progressContainer.style.display = showProgressCheckbox.checked ? 'block' : 'none';
    // Show/hide progress color picker with progress toggle
    progressColorGroup.style.display = showProgressCheckbox.checked ? 'flex' : 'none';
    // Ensure chroma picker visibility matches current mode on load
    chromaColorGroup.style.display = body.classList.contains('chroma') ? 'flex' : 'none';
    // Apply mode rules (minimal/count-up) for progress bar
    syncProgressUI();

    // Show/hide progress bar on checkbox toggle
    showProgressCheckbox.addEventListener('change', () => {
      // If minimal or count-up mode is active, enforce their rules
      if (minimalModeToggle.classList.contains('active') || (countUpToggle && countUpToggle.checked)) {
        syncProgressUI();
        return;
      }
      progressContainer.style.display = showProgressCheckbox.checked ? 'block' : 'none';
      progressColorGroup.style.display = showProgressCheckbox.checked ? 'flex' : 'none';
      
    });

    // Count up toggle affects progress bar availability
    if (countUpToggle) {
      countUpToggle.addEventListener('change', () => {
        syncProgressUI();
        
      });
    }

    

    // Reset Defaults handler restores colours, toggles, slider values, and queue state
    resetDefaultsBtn.addEventListener('click', async () => {
      // Stop timer if running / fullscreen
      if (running) await stopTimer();

      // Reset classes
      body.classList.remove('light', 'chroma', 'hide-cursor');
      timerEl.classList.remove('warning');
      timerEl.classList.add('white');
      minimalModeToggle.classList.remove('active');

      // Reset variables and UI controls
      timeInput.value = '';
      redThresholdSelect.value = '0';
      autostartToggle.checked = false;
      countUpToggle.checked = false;
      showProgressCheckbox.checked = false;
      showProgressCheckbox.disabled = false;
      syncProgressUI();

      // Reset colors
      document.documentElement.style.setProperty('--bg', 'black');
      document.documentElement.style.setProperty('--fg', 'white');
      document.documentElement.style.setProperty('--accent', '#ff4444');
      document.documentElement.style.setProperty('--warning', 'red');
      document.documentElement.style.setProperty('--chroma', '#00FF00');
      bgColor.value = '#000000';
      fgColor.value = '#ffffff';
      accentColor.value = '#ff4444';
      warningColor.value = '#ff0000';

      // Reset sizes
      timerSizeSlider.value = '15';
      const vw = timerSizeSlider.value;
      timerEl.style.fontSize = vw + 'vw';
      const heightVw = (parseFloat(vw) / 30) * 1.5;
      progressContainer.style.height = `${heightVw}vw`;
      progressContainer.style.width = `${parseFloat(vw) * 3}vw`;

      // Reset display
      timerEl.textContent = '00:00';
      timerEl.setAttribute('data-text', timerEl.textContent);
      progressBar.style.width = '0%';
      pausedText.classList.add('hidden');
      controls.classList.remove('hidden');
      startContainer.classList.remove('hidden');
      shortcutIndex.classList.remove('hidden');
      colorGrid.classList.remove('hidden');
      bottomRightControls.classList.remove('hidden');
      topRightControls.classList.remove('hidden');
      resetDefaultsBtn.classList.remove('hidden');
      timerQueue = [];
      queueActive = false;
      currentQueueDuration = null;
      if (queueToggle) {
        queueToggle.checked = false;
      }
      if (autoNextToggle) {
        autoNextToggle.checked = false;
      }
      autoNextEnabled = false;
      queueAwaitingNext = false;
      updateQueueVisibility();
      if (nextTimerButton) {
        nextTimerButton.classList.add('hidden');
      }
      renderQueue();
      modeToggle.textContent = 'Light Mode';
      chromaModeToggle.textContent = 'Chroma Mode';

      
    });

    
  </script>
</body>
</html>
